# Client configuration. All values are optional; flags take precedence.

# Backend base URL.
YAPAYAPA_SERVER=http://127.0.0.1:8080

# Data directory override (default: $XDG_DATA_HOME/yapayapa or ~/.local/share/yapayapa).
# YAPAYAPA_DATA_DIR=/path/to/dir

# Attachment size limit in bytes (default 10485760 = 10 MB).
# YAPAYAPA_MAX_ATTACHMENT_BYTES=10485760

# LAN discovery/transport is opt-in by design: it runs only while a
# `yapayapa peers ...` command is active. No env flag is needed.
