# Backend configuration (copy to backend/.env or export in the environment).

# PostgreSQL connection string. Required unless YAPAYAPA_MEM_STORE=1.
DATABASE_URL=postgres://yapayapa:change-me-for-anything-non-local@localhost:5432/yapayapa

# Address to listen on.
BIND_ADDR=127.0.0.1:8080

# Path to SQL migrations (defaults to ./migrations).
MIGRATIONS_DIR=./migrations

# Set to 1 to run with a non-persistent in-memory store (development and
# tests only; all data is lost on restart).
# YAPAYAPA_MEM_STORE=1

# Log filter (never logs plaintext or secrets at any level).
RUST_LOG=info
